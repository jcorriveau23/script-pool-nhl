# Poll live games every 3 minutes, around the clock. An earlier version only
# ran from noon to 02:57 Eastern to save container starts, but every game
# outside that window (a European Global Series afternoon, a night that ran
# late) was silently never polled, and the window had to be kept in step with
# the host's timezone. A run with no game in progress costs one container start.
#
# The 05:00 nightly chain now overlaps it. That is safe: each run replaces one
# `day_leaders` document in a single write, so nhl-cumulate-stats sees either
# the previous version or the new one, and by 05:00 last night's games are over.
[Unit]
Description=Poll NHL daily leaders every 3 minutes

[Timer]
OnCalendar=*:00/3
# No Persistent= here on purpose: after downtime the next run is at most three
# minutes away, so catching up on a missed one buys nothing.
Unit=nhl-job@nhl-daily-leaders.service

[Install]
WantedBy=timers.target
