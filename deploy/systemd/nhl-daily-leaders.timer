# Poll live games, but only during the hours games can actually be in progress.
# Two OnCalendar= lines are OR'd: noon through 02:57 Eastern, covering holiday
# matinees at one end and west-coast overtime at the other. The roughly nine
# remaining hours used to be ~180 container starts a day against a schedule that
# could not have changed.
#
# The gap also lands the 05:00 nightly chain outside this window, so
# nhl-cumulate-stats no longer reads `day_leaders` while this job is writing it.
#
# Eastern time, which is what the NHL schedule is built around, and spelled out
# on each line because the host runs on UTC: left to the host's clock this
# window closed at 22:57 ET, in the middle of the evening games.
[Unit]
Description=Poll NHL daily leaders every 3 minutes during game hours

[Timer]
OnCalendar=*-*-* 12..23:00/3 America/Toronto
OnCalendar=*-*-* 00..02:00/3 America/Toronto
# No Persistent= here on purpose: after downtime the next run is at most three
# minutes away, so catching up on a missed one buys nothing.
Unit=nhl-job@nhl-daily-leaders.service

[Install]
WantedBy=timers.target
