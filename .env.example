# Copy to .env and adjust. Every value below is a default from nhl_helper/config.py.

# --- Storage ---
NHL_HELPER_MONGO_URI=mongodb://localhost:27017
NHL_HELPER_MONGO_DATABASE=hockeypool

# --- Data sources ---
# The daily-leaders job reads the NHL API through a local proxy.
NHL_HELPER_NHL_PROXY_URL=http://localhost:3000/api
NHL_HELPER_NHL_SEARCH_URL=https://search.d3.nhle.com/api/v1/search/player
NHL_HELPER_CBS_INJURIES_URL=https://www.cbssports.com/nhl/injuries/
NHL_HELPER_CAPWAGES_URL=https://capwages.com/players/active
# The rust backend, which owns the season dates (GET /season-info). Use the
# reverse proxy, e.g. http://localhost/api-rust, if port 8000 is not exposed.
NHL_HELPER_POOL_API_URL=http://localhost:8000/api-rust
NHL_HELPER_REQUEST_TIMEOUT_SECONDS=30

# --- Outputs ---
# Point this at the frontend's public directory, e.g.
#   /home/you/dev/shad-cn-frontend-pool-nhl/frontend-pool-nhl/public/injured-players.json
NHL_HELPER_INJURED_PLAYERS_OUTPUT=injured-players.json
NHL_HELPER_NON_MATCHING_PLAYERS_OUTPUT=non-matching-players-cbs.json
